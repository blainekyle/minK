<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="mink.Views.ConfirmClearWindow"
        Title="Clear Conversation History — minK"
        Icon="/Assets/mink.ico"
        Width="420"
        Height="205"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#CCCCCC">

    <Grid RowDefinitions="*,Auto" Margin="20,18,20,18">
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="Clear Agent Conversation?"
                       FontSize="15.5"
                       FontWeight="SemiBold"
                       Foreground="#F0F4F8" />

            <TextBlock Text="This will clear all prompts and responses from the current Agent sidebar session."
                       FontSize="12.5"
                       Foreground="#A6A6A6"
                       TextWrapping="Wrap" />

            <CheckBox x:Name="DontAskAgainCheck"
                      Content="Don't ask again (can be reset in minK Preferences)"
                      FontSize="12"
                      Foreground="#CCCCCC"
                      Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,12,0,0">
            <Button Classes="toolbar-btn"
                    Content="Cancel"
                    IsCancel="True"
                    Padding="14,6"
                    Background="#2D2D30"
                    Click="OnCancelClick" />
            <Button Classes="danger-btn"
                    Content="Clear History"
                    IsDefault="True"
                    Padding="14,6"
                    FontSize="12"
                    Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
